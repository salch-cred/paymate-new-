# GOAT Mainnet RPC endpoint.
RPC_GOAT_MAINNET=https://rpc.goat.network

# Deployer / Admin key used by scripts/deploy.ts (PayMateTreasury & PayMateReputation).
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Authorized AI Agent Wallet for SSAO Philanthropy.
AI_AGENT_ADDRESS=0xYOUR_AI_AGENT_WALLET_ADDRESS

# ERC-8004 identity registry address (see scripts/register-erc8004.ts).
# Mainnet: 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
REGISTRY_CONTRACT=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# Human-readable agent name to register.
AGENT_NAME=
# Publicly reachable JSON metadata URL describing this agent (name,
# description, url, wallet) — e.g. a GitHub Gist raw link.
AGENT_URI=
