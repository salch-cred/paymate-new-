# Optional: enables AI-structured invoice drafting via OpenAI.
# A deterministic no-key parser is used automatically when this is blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GOAT Network mainnet (chain id 2345) RPC endpoint.
# NOTE (2026-07-30): the code reads RPC_GOAT_MAINNET, not RPC_GOAT_TESTNET.
# If you have RPC_GOAT_TESTNET set on your deployment instead, it is silently
# ignored and the app falls back to the public default GOAT mainnet RPC
# (usually fine, but you won't get your own rate limits/reliability).
RPC_GOAT_MAINNET=https://rpc.goat.network

# Settlement token PayMate accepts as "USDC" on GOAT mainnet.
# Must be the real bridged/Circle USDC contract address - NOT TestUSDC.sol or
# any token with a public faucet() mint function, or users can pay with a
# worthless token and it will be accepted as if it were real USDC.
USDC_TOKEN=0xYOUR_GOAT_MAINNET_USDC_ADDRESS
USDC_DECIMALS=6

# Deployed PayMateReputation contract address (see ../contracts).
REPUTATION_CONTRACT=0xYOUR_DEPLOYED_REPUTATION_CONTRACT

# Wallet authorized to call recordJob on the reputation contract
# (must be the same account that deployed PayMateReputation, its `issuer`).
PRIVATE_KEY=0xISSUER_PRIVATE_KEY

# Postgres connection string (e.g. from Neon, Vercel Postgres, Supabase).
# Required — invoice storage.
DATABASE_URL=

# Optional: WalletConnect Cloud project ID (from https://cloud.reown.com) to
# enable the WalletConnect connector for mobile/QR wallets. Injected wallets
# (MetaMask, Rabby, Brave) and Coinbase Wallet work without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Security-critical vars added in the 2026-07-29 audit fix ---
# Required. Shared secret the ClawUp platform must send as
# `Authorization: Bearer <value>` when calling /api/clawup/intent, which can
# trigger a real autonomous USDC payment. Never leave unset.
CLAWUP_SHARED_SECRET=

# Required. Shared secret /api/agent/pay expects as
# `Authorization: Bearer <value>` before triggering a real autonomous USDC
# payout for an invoice. Added 2026-07-30: this endpoint duplicates
# /api/clawup/intent's payout path and must be locked down the same way.
AGENT_PAY_ADMIN_SECRET=

# Required. Bearer token /api/cron/recurring expects as
# `Authorization: Bearer <value>`. Never leave unset — this endpoint mutates the DB.
CRON_SECRET=

# Required to accept real Telegram webhook traffic. Set the same value as the
# `secret_token` param when calling Telegram's setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Required to accept real GitHub webhook traffic (HMAC secret configured on
# the GitHub webhook itself).
GITHUB_WEBHOOK_SECRET=

# Required to accept real Slack Events API traffic (from your Slack app's
# "Signing Secret").
SLACK_SIGNING_SECRET=

# Optional. Caps total autonomous agent payout volume per rolling hour across
# ALL invoices, independent of the per-invoice $5,000 cap. Defaults to 10000.
AGENT_HOURLY_PAYOUT_CAP_USD=10000

# Required to be explicitly "true" before the agent will settle real payments
# on GOAT mainnet (chainId 2345). This is a deliberate safety switch — only
# set it after confirming USDC_TOKEN points at the real bridged/Circle USDC
# contract, NOT TestUSDC.sol or any token with a public faucet() mint function.
USDC_IS_REAL_MAINNET_TOKEN=false
